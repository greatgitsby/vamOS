&pm8998_gpios {
	camera_rear_dvdd_en_default: camera-rear-dvdd-en-state {
		pins = "gpio12";
		function = "normal";
		power-source = <0>;
		bias-pull-down;
		drive-push-pull;
		qcom,drive-strength = <PMIC_GPIO_STRENGTH_HIGH>;
		output-low;
	};
};

&tlmm {
	cam_sensor_mclk0_active: cam-sensor-mclk0-active-state {
		pins = "gpio13";
		function = "cam_mclk";
		bias-disable;
		drive-strength = <2>;
	};

	cam_sensor_mclk0_suspend: cam-sensor-mclk0-suspend-state {
		pins = "gpio13";
		function = "cam_mclk";
		bias-pull-down;
		drive-strength = <8>;
	};

	cam_sensor_mclk1_active: cam-sensor-mclk1-active-state {
		pins = "gpio14";
		function = "cam_mclk";
		bias-disable;
		drive-strength = <2>;
	};

	cam_sensor_mclk1_suspend: cam-sensor-mclk1-suspend-state {
		pins = "gpio14";
		function = "cam_mclk";
		bias-pull-down;
		drive-strength = <8>;
	};

	cam_sensor_mclk2_active: cam-sensor-mclk2-active-state {
		pins = "gpio15";
		function = "cam_mclk";
		bias-disable;
		drive-strength = <2>;
	};

