		bias-pull-down;
		drive-strength = <2>;
		output-low;
	};

	cam_sensor_reset1_active: cam-sensor-reset1-active-state {
		pins = "gpio7";
		function = "gpio";
		bias-disable;
		drive-strength = <2>;
	};

	cam_sensor_reset1_suspend: cam-sensor-reset1-suspend-state {
		pins = "gpio7";
		function = "gpio";
		bias-pull-down;
		drive-strength = <2>;
		output-low;
