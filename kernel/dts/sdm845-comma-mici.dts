/dts-v1/;

#include "sdm845-comma-common.dtsi"

/ {
	model = "comma mici";
	compatible = "comma,mici", "qcom,sdm845";
	qcom,msm-id = <341 0x20001>, <321 0x20001>, <321 0x20000>, <348 0x20001>;
	qcom,board-id = <0x22 0>;

	aliases {
		hsuart0 = &uart3;
	};
};

&i2c5 {
	touchscreen@38 {
		compatible = "focaltech,ft3168";
		reg = <0x38>;

		interrupt-parent = <&tlmm>;
		interrupts = <125 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;

		iovcc-supply = <&vreg_s4a_1p8>;
		vcc-supply = <&lcd3v3>;

		touchscreen-size-x = <240>;
		touchscreen-size-y = <536>;
	};
};

&mdss_dsi0 {
	panel@0 {
		compatible = "dwo,do0200fat07";

		reg = <0>;

		vddio-supply = <&vreg_l14a_1p88>;
		vdd-supply = <&lcd3v3>;

		reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;

		rotation = <90>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel_in>;
	data-lanes = <0>;
};

&uart3 {
	status = "okay";
};

&wifi {
	qcom,calibration-variant = "comma-mici";
};

/*
 * Board requirement carried from legacy AGNOS (comma_mici.dts: "&pm8998_l8 {
 * regulator-always-on; }"): L8 (1.2V) feeds the camera sensor power chain on
 * mici with no DT-visible consumer. Without it all three OS04C10s NACK their
 * I2C address (rails/MCLK/CCI all measure correct) — found 2026-07-01 via a
 * legacy-vs-mainline PMIC SPMI register diff. mici-only, as in legacy.
 */
&vreg_l8a_1p2 {
	regulator-always-on;
};
