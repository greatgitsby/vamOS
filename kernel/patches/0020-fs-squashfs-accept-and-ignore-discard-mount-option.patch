From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:01 2001
From: vamos <vamos@comma.ai>
Date: Wed, 1 Jul 2026 18:00:00 -0700
Subject: fs: squashfs: accept and ignore discard mount option

AGNOS fstab mounts /persist (squashfs) with "discard". The fs_context
parser rejects unknown parameters, failing the mount and dropping every
boot into the emergency shell. Legacy 4.9 silently ignored it; do the
same.
---

diff --git a/fs/squashfs/super.c b/fs/squashfs/super.c
index 4465cf056..1647058f8 100644
--- a/fs/squashfs/super.c
+++ b/fs/squashfs/super.c
@@ -48,6 +48,7 @@ enum Opt_errors {
 enum squashfs_param {
 	Opt_errors,
 	Opt_threads,
+	Opt_discard,
 };
 
 struct squashfs_mount_opts {
@@ -65,6 +66,7 @@ static const struct constant_table squashfs_param_errors[] = {
 static const struct fs_parameter_spec squashfs_fs_parameters[] = {
 	fsparam_enum("errors", Opt_errors, squashfs_param_errors),
 	fsparam_string("threads", Opt_threads),
+	fsparam_flag("discard", Opt_discard),
 	{}
 };
 
@@ -142,6 +144,9 @@ static int squashfs_parse_param(struct fs_context *fc, struct fs_parameter *para
 		if (squashfs_parse_param_threads(param->string, opts) != 0)
 			return -EINVAL;
 		break;
+	case Opt_discard:
+		/* accepted and ignored: read-only fs, but legacy fstabs pass it */
+		break;
 	default:
 		return -EINVAL;
 	}
