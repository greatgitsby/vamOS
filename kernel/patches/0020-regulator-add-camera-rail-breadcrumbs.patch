From 8c7e4f0d5ad703bedc827b833d03ec9cf8d30016 Mon Sep 17 00:00:00 2001
From: Trey <trey@comma.ai>
Date: Mon, 15 Jun 2026 13:10:00 +0000
Subject: regulator: add temporary camera rail breadcrumbs

Sensor probe currently NACKs even though the Spectra driver reports the
power sequence succeeded. Raw GPIO bitbang also sees no ACK, which pushes
the next question below the CCI command stream: did the PMIC GPIO-backed
DVDD enable rail physically get driven high?

Add temporary breadcrumbs around the camera_rear_ldo enable GPIO and PMIC
GPIO12 register programming. This is intentionally noisy and scoped to the
camera DVDD path so it can be removed once the rail/reset state is proven.
---
 drivers/pinctrl/qcom/pinctrl-spmi-gpio.c | 57 +++++++++++++++++++++--
 drivers/regulator/core.c                  | 31 +++++++++---
 drivers/regulator/fixed.c                 |  7 +++
 3 files changed, 84 insertions(+), 11 deletions(-)

diff --git a/drivers/pinctrl/qcom/pinctrl-spmi-gpio.c b/drivers/pinctrl/qcom/pinctrl-spmi-gpio.c
index 485b68cc9..8f546dc0c 100644
--- a/drivers/pinctrl/qcom/pinctrl-spmi-gpio.c
+++ b/drivers/pinctrl/qcom/pinctrl-spmi-gpio.c
@@ -251,6 +251,36 @@ static int pmic_gpio_write(struct pmic_gpio_state *state,
 	return ret;
 }
 
+static void pmic_gpio_vamos_dump(struct pmic_gpio_state *state,
+				 struct pmic_gpio_pad *pad,
+				 unsigned int pin, const char *where,
+				 int value, int ret)
+{
+	int rt, mode, vin, pull, in_ctl, out_ctl, en_ctl, lvmv_out;
+
+	if (pin != 11)
+		return;
+
+	rt = pmic_gpio_read(state, pad, PMIC_MPP_REG_RT_STS);
+	mode = pmic_gpio_read(state, pad, PMIC_GPIO_REG_MODE_CTL);
+	vin = pmic_gpio_read(state, pad, PMIC_GPIO_REG_DIG_VIN_CTL);
+	pull = pmic_gpio_read(state, pad, PMIC_GPIO_REG_DIG_PULL_CTL);
+	in_ctl = pmic_gpio_read(state, pad, PMIC_GPIO_REG_DIG_IN_CTL);
+	out_ctl = pmic_gpio_read(state, pad, PMIC_GPIO_REG_DIG_OUT_CTL);
+	en_ctl = pmic_gpio_read(state, pad, PMIC_GPIO_REG_EN_CTL);
+	lvmv_out = pad->lv_mv_type ?
+		pmic_gpio_read(state, pad, PMIC_GPIO_REG_LV_MV_DIG_OUT_SOURCE_CTL) :
+		-1;
+
+	pr_emerg("vamos-pmic-gpio: %s dev=%s usid=%u pid_base=0x%x pin=%u phys=%u base=0x%x value=%d ret=%d cache enabled=%d out=%d in_en=%d out_en=%d analog=%d lv_mv=%d ps=%u pull=%u strength=%u func=%u mode=0x%x rt=0x%x vin=0x%x pull_ctl=0x%x in_ctl=0x%x out_ctl=0x%x en=0x%x lvmv_out=0x%x\n",
+		 where, dev_name(state->dev), state->usid, state->pid_base,
+		 pin, pin + PMIC_GPIO_PHYSICAL_OFFSET, pad->base, value, ret,
+		 pad->is_enabled, pad->out_value, pad->input_enabled,
+		 pad->output_enabled, pad->analog_pass, pad->lv_mv_type,
+		 pad->power_source, pad->pullup, pad->strength, pad->function,
+		 mode, rt, vin, pull, in_ctl, out_ctl, en_ctl, lvmv_out);
+}
+
 static int pmic_gpio_get_groups_count(struct pinctrl_dev *pctldev)
 {
 	/* Every PIN is a group */
@@ -650,6 +680,8 @@ static int pmic_gpio_config_set(struct pinctrl_dev *pctldev, unsigned int pin,
 
 	ret = pmic_gpio_write(state, pad, PMIC_GPIO_REG_EN_CTL, val);
 
+	pmic_gpio_vamos_dump(state, pad, pin, "config_set", -1, ret);
+
 	return ret;
 }
 
@@ -735,11 +767,16 @@ static int pmic_gpio_direction_output(struct gpio_chip *chip,
 				      unsigned pin, int val)
 {
 	struct pmic_gpio_state *state = gpiochip_get_data(chip);
+	struct pmic_gpio_pad *pad = state->ctrl->desc->pins[pin].drv_data;
 	unsigned long config;
+	int ret;
 
 	config = pinconf_to_config_packed(PIN_CONFIG_LEVEL, val);
 
-	return pmic_gpio_config_set(state->ctrl, pin, &config, 1);
+	ret = pmic_gpio_config_set(state->ctrl, pin, &config, 1);
+	pmic_gpio_vamos_dump(state, pad, pin, "direction_output", val, ret);
+
+	return ret;
 }
 
 static int pmic_gpio_get(struct gpio_chip *chip, unsigned pin)
@@ -768,10 +805,15 @@ static int pmic_gpio_set(struct gpio_chip *chip, unsigned int pin, int value)
 {
 	struct pmic_gpio_state *state = gpiochip_get_data(chip);
 	unsigned long config;
+	struct pmic_gpio_pad *pad = state->ctrl->desc->pins[pin].drv_data;
+	int ret;
 
 	config = pinconf_to_config_packed(PIN_CONFIG_LEVEL, value);
 
-	return pmic_gpio_config_set(state->ctrl, pin, &config, 1);
+	ret = pmic_gpio_config_set(state->ctrl, pin, &config, 1);
+	pmic_gpio_vamos_dump(state, pad, pin, "set", value, ret);
+
+	return ret;
 }
 
 static int pmic_gpio_of_xlate(struct gpio_chip *chip,
diff --git a/drivers/regulator/core.c b/drivers/regulator/core.c
index dd7b10e76..7920a4ad5 100644
--- a/drivers/regulator/core.c
+++ b/drivers/regulator/core.c
@@ -2681,10 +2681,20 @@ static void regulator_ena_gpio_free(struct regulator_dev *rdev)
 static int regulator_ena_gpio_ctrl(struct regulator_dev *rdev, bool enable)
 {
 	struct regulator_enable_gpio *pin = rdev->ena_pin;
+	const char *name = rdev_get_name(rdev);
+	bool vamos_cam = name && !strcmp(name, "camera_rear_ldo");
+	int gpio_before = -999, gpio_after = -999;
 
 	if (!pin)
 		return -EINVAL;
 
+	if (vamos_cam) {
+		gpio_before = gpiod_get_value_cansleep(pin->gpiod);
+		pr_emerg("vamos-regulator-gpio: ctrl begin name=%s enable=%d shared_before=%u request_count=%u rdev_state=%u gpio_before=%d\n",
+			 name, enable, pin->enable_count, pin->request_count,
+			 rdev->ena_gpio_state, gpio_before);
+	}
+
 	if (enable) {
 		/* Enable GPIO at initial use */
 		if (pin->enable_count == 0)
@@ -2694,6 +2704,12 @@ static int regulator_ena_gpio_ctrl(struct regulator_dev *rdev, bool enable)
 	} else {
 		if (pin->enable_count > 1) {
 			pin->enable_count--;
+			if (vamos_cam) {
+				gpio_after = gpiod_get_value_cansleep(pin->gpiod);
+				pr_emerg("vamos-regulator-gpio: ctrl end name=%s enable=%d shared_after=%u request_count=%u rdev_state=%u gpio_after=%d kept_on=1\n",
+					 name, enable, pin->enable_count, pin->request_count,
+					 rdev->ena_gpio_state, gpio_after);
+			}
 			return 0;
 		}
 
@@ -2704,6 +2720,13 @@ static int regulator_ena_gpio_ctrl(struct regulator_dev *rdev, bool enable)
 		}
 	}
 
+	if (vamos_cam) {
+		gpio_after = gpiod_get_value_cansleep(pin->gpiod);
+		pr_emerg("vamos-regulator-gpio: ctrl end name=%s enable=%d shared_after=%u request_count=%u rdev_state=%u gpio_after=%d kept_on=0\n",
+			 name, enable, pin->enable_count, pin->request_count,
+			 rdev->ena_gpio_state, gpio_after);
+	}
+
 	return 0;
 }
 
diff --git a/drivers/regulator/fixed.c b/drivers/regulator/fixed.c
index a2d16e9ab..6c62776b3 100644
--- a/drivers/regulator/fixed.c
+++ b/drivers/regulator/fixed.c
@@ -323,6 +323,13 @@ static int reg_fixed_voltage_probe(struct platform_device *pdev)
 		return dev_err_probe(&pdev->dev, PTR_ERR(cfg.ena_gpiod),
 				     "can't get GPIO\n");
 
+	if (drvdata->desc.name && !strcmp(drvdata->desc.name, "camera_rear_ldo")) {
+		int gpio_val = cfg.ena_gpiod ?
+			gpiod_get_value_cansleep(cfg.ena_gpiod) : -999;
+
+		dev_info(&pdev->dev, "vamos-reg-fixed: probe name=%s ena_gpiod=%p gpio_val=%d enabled_at_boot=%d gflags=0x%x fixed_uV=%d\n",
+			 drvdata->desc.name, cfg.ena_gpiod, gpio_val, config->enabled_at_boot, gflags, config->microvolts);
+	}
 	cfg.dev = &pdev->dev;
 	cfg.init_data = config->init_data;
 	cfg.driver_data = drvdata;
