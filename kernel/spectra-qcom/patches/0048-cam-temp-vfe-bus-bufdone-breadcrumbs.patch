From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:01 2001
From: Trey Moen <trey@moen.ai>
Date: Fri, 3 Jul 2026 00:00:00 -0700
Subject: cam: TEMP vfe bus buf-done breadcrumbs (post-0047 hunt)

With SOF/EPOCH/RUP now firing (0047), requests apply and CDM commits per
frame, but the FULL output WM never generates buf_done ("Resource_Handle:
[FULL][0x3000] Sync_ID: [0x1]" fail log) -> congestion -> apply reject ->
CRM error recovery -> the known runtime FLUSHED wall. Print the bus
top-half raw statuses (does the bus irq fire at all?), the vfe_out
subscribe masks, and the WM start geometry to localize whether the WM
writes and the irq is lost, or the WM never writes. REMOVE when done.
---

diff --git a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_isp/isp_hw_mgr/isp_hw/vfe_hw/vfe_bus/cam_vfe_bus_ver2.c b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_isp/isp_hw_mgr/isp_hw/vfe_hw/vfe_bus/cam_vfe_bus_ver2.c
index 71bccfa..daf72c8 100644
--- a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_isp/isp_hw_mgr/isp_hw/vfe_hw/vfe_bus/cam_vfe_bus_ver2.c
+++ b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_isp/isp_hw_mgr/isp_hw/vfe_hw/vfe_bus/cam_vfe_bus_ver2.c
@@ -1517,6 +1517,10 @@ static int cam_vfe_bus_start_wm(
 	 * i.e enable wm only if io buffers are allocated
 	 */
 
+	pr_err("vamos-bus2: start_wm idx=%d w=%d h=%d stride=%d en_ubwc=%d irq1_bit=0x%x\n",
+		rsrc_data->index, rsrc_data->width, rsrc_data->height,
+		rsrc_data->stride, rsrc_data->en_ubwc,
+		(1 << rsrc_data->index));
 	CAM_DBG(CAM_ISP, "WM res %d width = %d, height = %d", rsrc_data->index,
 		rsrc_data->width, rsrc_data->height);
 	CAM_DBG(CAM_ISP, "WM res %d pk_fmt = %d", rsrc_data->index,
@@ -2625,6 +2629,11 @@ static int cam_vfe_bus_start_vfe_out(
 			bus_irq_reg_mask);
 	}
 
+	pr_err("vamos-bus2: start_vfe_out res=0x%x num_wm=%d comp=%d irq_mask=[0x%x 0x%x 0x%x]\n",
+		vfe_out->res_id, rsrc_data->num_wm,
+		rsrc_data->comp_grp ? 1 : 0,
+		bus_irq_reg_mask[0], bus_irq_reg_mask[1],
+		bus_irq_reg_mask[2]);
 	vfe_out->irq_handle = cam_irq_controller_subscribe_irq(
 		common_data->bus_irq_controller, CAM_IRQ_PRIORITY_1,
 		bus_irq_reg_mask, vfe_out, vfe_out->top_half_handler,
@@ -2637,6 +2646,8 @@ static int cam_vfe_bus_start_vfe_out(
 		vfe_out->irq_handle = 0;
 		return -EFAULT;
 	}
+	pr_err("vamos-bus2: start_vfe_out res=0x%x subscribed handle=%d\n",
+		vfe_out->res_id, vfe_out->irq_handle);
 
 	vfe_out->res_state = CAM_ISP_RESOURCE_STATE_STREAMING;
 	return rc;
@@ -2893,6 +2904,13 @@ static int cam_vfe_bus_ver2_handle_irq(uint32_t    evt_id,
 	int rc = 0;
 
 	bus_priv     = th_payload->handler_priv;
+	pr_err("vamos-bus2: bus irq st0=0x%x st1=0x%x st2=0x%x\n",
+		th_payload->num_registers > 0 ?
+			th_payload->evt_status_arr[0] : 0,
+		th_payload->num_registers > 1 ?
+			th_payload->evt_status_arr[1] : 0,
+		th_payload->num_registers > 2 ?
+			th_payload->evt_status_arr[2] : 0);
 	CAM_DBG(CAM_ISP, "Enter");
 	rc = cam_irq_controller_handle_irq(evt_id,
 		bus_priv->common_data.bus_irq_controller);
