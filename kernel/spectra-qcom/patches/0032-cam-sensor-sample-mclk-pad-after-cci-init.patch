+static void vamos_cam_sensor_sample_mclk_pad(const char *tag,
+	struct cam_sensor_ctrl_t *s_ctrl)
+{
+	struct msm_camera_gpio_num_info *gpio_num_info;
+	int i;
+	int mclk_gpio = -EINVAL;
+	const char *mclk_source = "none";
+
+	if (!s_ctrl || !s_ctrl->sensordata) {
+		pr_emerg("vamos-cam-sensor: mclk-pad %s invalid s_ctrl=%pK\n",
+			tag, s_ctrl);
+		return;
+	}
+
+	gpio_num_info = s_ctrl->sensordata->power_info.gpio_num_info;
+	if (gpio_num_info && gpio_num_info->valid[SENSOR_MCLK]) {
+		mclk_gpio = gpio_num_info->gpio_num[SENSOR_MCLK];
+		mclk_source = "gpio-num-info";
+	} else if (s_ctrl->soc_info.gpio_data &&
+		s_ctrl->soc_info.gpio_data->cam_gpio_req_tbl) {
+		cam_gpio *gpio_tbl =
+			s_ctrl->soc_info.gpio_data->cam_gpio_req_tbl;
+		uint8_t size =
+			s_ctrl->soc_info.gpio_data->cam_gpio_req_tbl_size;
+
+		for (i = 0; i < size; i++) {
+			if (!gpio_tbl[i].label ||
+				strncmp(gpio_tbl[i].label, "CAMIF_MCLK",
+					sizeof("CAMIF_MCLK") - 1))
+				continue;
+			mclk_gpio = gpio_tbl[i].gpio;
+			mclk_source = "req-tbl";
+			break;
+		}
+	}
+
+	if (gpio_is_valid(mclk_gpio)) {
+		int val;
+		int prev;
+		int ones = 0;
+		int zeros = 0;
+		int transitions = 0;
+
+		vamos_cam_bitbang_dump_tlmm(tag, mclk_gpio);
+		prev = vamos_cam_i2c_sample(mclk_gpio);
+		if (prev)
+			ones++;
+		else
+			zeros++;
+
+		for (i = 1; i < 256; i++) {
+			udelay(1);
+			val = vamos_cam_i2c_sample(mclk_gpio);
+			if (val)
+				ones++;
+			else
+				zeros++;
+			if (val != prev)
+				transitions++;
+			prev = val;
+		}
+		pr_emerg("vamos-cam-sensor: mclk-pad %s slot=%d valid=1 source=%s gpio_valid=%u gpio=%d ones=%d zeros=%d transitions=%d final=%d\n",
+			tag, s_ctrl->soc_info.index, mclk_source,
+			gpio_num_info ? gpio_num_info->valid[SENSOR_MCLK] : 0,
+			mclk_gpio, ones, zeros, transitions, prev);
+	} else {
+		pr_emerg("vamos-cam-sensor: mclk-pad %s slot=%d valid=0 source=%s gpio_valid=%u gpio=%d req_tbl=%pK\n",
+			tag, s_ctrl->soc_info.index, mclk_source,
+			gpio_num_info ? gpio_num_info->valid[SENSOR_MCLK] : 0,
+			mclk_gpio,
+			s_ctrl->soc_info.gpio_data ?
+				s_ctrl->soc_info.gpio_data->cam_gpio_req_tbl : NULL);
+	}
+}
+
 static void vamos_cam_i2c_start(int sda, int scl)
 {
 	vamos_cam_i2c_release(sda);
@@ -1525,9 +1600,13 @@ int32_t cam_sensor_driver_cmd(struct cam_sensor_ctrl_t *s_ctrl,
 		pr_emerg("vamos-cam-sensor: temporary powered probe hold 3000ms begin\n");
 		vamos_cam_sensor_dump_all_mclk_regs("pre-match-before-hold",
 			s_ctrl);
+		vamos_cam_sensor_sample_mclk_pad("pre-match-before-hold",
+			s_ctrl);
 		msleep(3000);
 		vamos_cam_sensor_dump_all_mclk_regs("pre-match-after-hold",
 			s_ctrl);
+		vamos_cam_sensor_sample_mclk_pad("pre-match-after-hold",
+			s_ctrl);
 		pr_emerg("vamos-cam-sensor: slot %d match_id begin slave=0x%x reg=0x%x expected=0x%x\n",
 			s_ctrl->soc_info.index,
 			s_ctrl->sensordata->slave_info.sensor_slave_addr,
@@ -2176,6 +2255,8 @@ int cam_sensor_power_up(struct cam_sensor_ctrl_t *s_ctrl)
 	}
 	vamos_cam_sensor_dump_all_mclk_regs("post-camera-io-init",
 		s_ctrl);
