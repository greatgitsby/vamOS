+static u32 cam_cci_sdm845_tlmm_offset(unsigned int local_gpio)
+{
+	return cam_cci_sdm845_tlmm_region(local_gpio) +
+		(local_gpio * CAM_CCI_SDM845_TLMM_REG_SIZE);
+}
+
+static void cam_cci_sample_sdm845_tlmm_bus_mapped(void __iomem *tlmm,
+	const char *tag, enum cci_i2c_master_t master)
+{
+	u32 sda_offset;
+	u32 scl_offset;
+	u32 sda_io = 0;
+	u32 scl_io = 0;
+	unsigned int sda_gpio;
+	unsigned int scl_gpio;
+	unsigned int sda_ones = 0;
+	unsigned int sda_zeros = 0;
+	unsigned int sda_transitions = 0;
+	unsigned int scl_ones = 0;
+	unsigned int scl_zeros = 0;
+	unsigned int scl_transitions = 0;
+	int sda_first = -1;
+	int sda_prev = -1;
+	int sda_val = -1;
+	int scl_first = -1;
+	int scl_prev = -1;
+	int scl_val = -1;
+	int i;
+
+	if (!tlmm || master >= MASTER_MAX)
+		return;
+
+	sda_gpio = master == MASTER_1 ? 19 : 17;
+	scl_gpio = master == MASTER_1 ? 20 : 18;
+	sda_offset = cam_cci_sdm845_tlmm_offset(sda_gpio);
+	scl_offset = cam_cci_sdm845_tlmm_offset(scl_gpio);
+
+	for (i = 0; i < 1024; i++) {
+		sda_io = readl_relaxed(tlmm + sda_offset + 0x4);
+		scl_io = readl_relaxed(tlmm + scl_offset + 0x4);
+		sda_val = sda_io & 0x1;
+		scl_val = scl_io & 0x1;
+
+		if (!i) {
+			sda_first = sda_val;
+			scl_first = scl_val;
+		} else {
+			if (sda_val != sda_prev)
+				sda_transitions++;
+			if (scl_val != scl_prev)
+				scl_transitions++;
+		}
+
+		if (sda_val)
+			sda_ones++;
+		else
+			sda_zeros++;
+		if (scl_val)
+			scl_ones++;
+		else
+			scl_zeros++;
+
+		sda_prev = sda_val;
+		scl_prev = scl_val;
+	}
+
+	pr_emerg("vamos-cam-cci: sample %s master=%d sda_gpio=%u sda_ones=%u sda_zeros=%u sda_transitions=%u sda_first=%d sda_final=%d sda_io=0x%x scl_gpio=%u scl_ones=%u scl_zeros=%u scl_transitions=%u scl_first=%d scl_final=%d scl_io=0x%x\n",
+		tag, master, sda_gpio, sda_ones, sda_zeros,
+		sda_transitions, sda_first, sda_val, sda_io, scl_gpio,
+		scl_ones, scl_zeros, scl_transitions, scl_first, scl_val,
+		scl_io);
+}
+
