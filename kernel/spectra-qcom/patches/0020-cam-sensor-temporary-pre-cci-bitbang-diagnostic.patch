+
+	if (s_ctrl->io_master_info.master_type == CCI_MASTER)
+		pr_emerg("vamos-cam-sensor: slot %d temporary pre-cci bitbang rc=%d\n",
+			s_ctrl->soc_info.index,
+			vamos_cam_sensor_bitbang_chipid(s_ctrl));
 
 	pr_emerg("vamos-cam-sensor: slot %d temporary pre-cci-init powered hold 3000ms begin\n",
 		s_ctrl->soc_info.index);
