 #include "cam_dp_bdg_core.h"
 
 
+#define VAMOS_CAM_I2C_DELAY_US 5
+
+static void vamos_cam_i2c_delay(void)
+{
+	udelay(VAMOS_CAM_I2C_DELAY_US);
+}
+
+static void vamos_cam_i2c_release(int gpio)
+{
+	gpio_direction_input(gpio);
+	vamos_cam_i2c_delay();
+}
+
+static void vamos_cam_i2c_low(int gpio)
+{
+	gpio_direction_output(gpio, 0);
+	vamos_cam_i2c_delay();
+}
+
+static int vamos_cam_i2c_sample(int gpio)
+{
+	return gpio_get_value_cansleep(gpio);
+}
+
+static void vamos_cam_i2c_start(int sda, int scl)
+{
+	vamos_cam_i2c_release(sda);
+	vamos_cam_i2c_release(scl);
+	vamos_cam_i2c_low(sda);
+	vamos_cam_i2c_low(scl);
+}
+
+static void vamos_cam_i2c_stop(int sda, int scl)
+{
+	vamos_cam_i2c_low(sda);
+	vamos_cam_i2c_release(scl);
+	vamos_cam_i2c_release(sda);
+}
+
+static int vamos_cam_i2c_write_byte(int sda, int scl, uint8_t byte)
+{
+	int bit;
+	int nack;
+
+	for (bit = 7; bit >= 0; bit--) {
+		if (byte & BIT(bit))
+			vamos_cam_i2c_release(sda);
+		else
+			vamos_cam_i2c_low(sda);
+		vamos_cam_i2c_release(scl);
+		vamos_cam_i2c_low(scl);
+	}
+
+	vamos_cam_i2c_release(sda);
+	vamos_cam_i2c_release(scl);
+	nack = vamos_cam_i2c_sample(sda);
+	vamos_cam_i2c_low(scl);
+	return nack;
+}
+
+static uint8_t vamos_cam_i2c_read_byte(int sda, int scl, bool nack)
+{
+	uint8_t byte = 0;
+	int bit;
+
+	vamos_cam_i2c_release(sda);
+	for (bit = 7; bit >= 0; bit--) {
+		vamos_cam_i2c_release(scl);
+		if (vamos_cam_i2c_sample(sda))
+			byte |= BIT(bit);
+		vamos_cam_i2c_low(scl);
+	}
+
+	if (nack)
+		vamos_cam_i2c_release(sda);
+	else
+		vamos_cam_i2c_low(sda);
+	vamos_cam_i2c_release(scl);
+	vamos_cam_i2c_low(scl);
+	vamos_cam_i2c_release(sda);
+
+	return byte;
+}
+
+static int vamos_cam_sensor_bitbang_chipid(struct cam_sensor_ctrl_t *s_ctrl)
+{
+	int rc;
+	int sda_gpio;
+	int scl_gpio;
+	int tlmm_base;
+	int sda_before;
+	int scl_before;
+	int sda_after_req;
+	int scl_after_req;
+	int nack_addr_w = -1;
+	int nack_reg_hi = -1;
+	int nack_reg_lo = -1;
+	int nack_addr_r = -1;
+	uint8_t b0 = 0xff;
+	uint8_t b1 = 0xff;
+	uint16_t chipid;
+	uint16_t reg_addr;
+	uint8_t sid7;
+	struct msm_camera_gpio_num_info *gpio_num_info =
+		s_ctrl->sensordata->power_info.gpio_num_info;
+
+	if (!gpio_num_info || !gpio_num_info->valid[SENSOR_VANA]) {
+		pr_emerg("vamos-cam-bitbang: slot %d skip no-vana-gpio gpio_info=%pK\n",
+			s_ctrl->soc_info.index, gpio_num_info);
+		return -EINVAL;
+	}
+
+	tlmm_base = gpio_num_info->gpio_num[SENSOR_VANA] - 8;
+	sda_gpio = tlmm_base + (s_ctrl->cci_i2c_master ? 19 : 17);
+	scl_gpio = tlmm_base + (s_ctrl->cci_i2c_master ? 20 : 18);
+	sid7 = s_ctrl->sensordata->slave_info.sensor_slave_addr >> 1;
+	reg_addr = s_ctrl->sensordata->slave_info.sensor_id_reg_addr;
+
+	sda_before = vamos_cam_i2c_sample(sda_gpio);
+	scl_before = vamos_cam_i2c_sample(scl_gpio);
+	pr_emerg("vamos-cam-bitbang: slot %d begin master=%d sid7=0x%x reg=0x%x sda=%d scl=%d before sda=%d scl=%d\n",
+		s_ctrl->soc_info.index, s_ctrl->cci_i2c_master, sid7,
+		reg_addr, sda_gpio, scl_gpio, sda_before, scl_before);
+
+	rc = gpio_request(sda_gpio, "vamos_cam_diag_sda");
+	if (rc) {
+		pr_emerg("vamos-cam-bitbang: slot %d request-sda gpio=%d rc=%d\n",
+			s_ctrl->soc_info.index, sda_gpio, rc);
+		return rc;
+	}
+
+	rc = gpio_request(scl_gpio, "vamos_cam_diag_scl");
+	if (rc) {
+		pr_emerg("vamos-cam-bitbang: slot %d request-scl gpio=%d rc=%d\n",
+			s_ctrl->soc_info.index, scl_gpio, rc);
+		gpio_free(sda_gpio);
+		return rc;
+	}
+
+	vamos_cam_i2c_release(sda_gpio);
+	vamos_cam_i2c_release(scl_gpio);
+	sda_after_req = vamos_cam_i2c_sample(sda_gpio);
+	scl_after_req = vamos_cam_i2c_sample(scl_gpio);
+
+	vamos_cam_i2c_start(sda_gpio, scl_gpio);
+	nack_addr_w = vamos_cam_i2c_write_byte(sda_gpio, scl_gpio,
+		(sid7 << 1) | 0);
+	nack_reg_hi = vamos_cam_i2c_write_byte(sda_gpio, scl_gpio,
+		(reg_addr >> 8) & 0xff);
+	nack_reg_lo = vamos_cam_i2c_write_byte(sda_gpio, scl_gpio,
+		reg_addr & 0xff);
+	vamos_cam_i2c_start(sda_gpio, scl_gpio);
+	nack_addr_r = vamos_cam_i2c_write_byte(sda_gpio, scl_gpio,
+		(sid7 << 1) | 1);
+	b0 = vamos_cam_i2c_read_byte(sda_gpio, scl_gpio, false);
+	b1 = vamos_cam_i2c_read_byte(sda_gpio, scl_gpio, true);
+	vamos_cam_i2c_stop(sda_gpio, scl_gpio);
+
+	chipid = ((uint16_t)b0 << 8) | b1;
+	pr_emerg("vamos-cam-bitbang: slot %d result after_req sda=%d scl=%d nack_addr_w=%d nack_reg_hi=%d nack_reg_lo=%d nack_addr_r=%d b0=0x%02x b1=0x%02x chip=0x%04x\n",
+		s_ctrl->soc_info.index, sda_after_req, scl_after_req,
+		nack_addr_w, nack_reg_hi, nack_reg_lo, nack_addr_r,
+		b0, b1, chipid);
+
+	gpio_free(scl_gpio);
+	gpio_free(sda_gpio);
+	return 0;
+}
+
 static int cam_sensor_update_req_mgr(
 	struct cam_sensor_ctrl_t *s_ctrl,
 	struct cam_packet *csl_packet)
@@ -1610,6 +1779,11 @@ int cam_sensor_power_up(struct cam_sensor_ctrl_t *s_ctrl)
 		pr_emerg("vamos-cam-sensor: slot %d temporary dvdd-cycle diagnostic end found=%d\n",
