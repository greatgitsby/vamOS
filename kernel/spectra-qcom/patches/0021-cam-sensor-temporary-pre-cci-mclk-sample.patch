diff --git a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c
index bce4a58..7a33d4a 100644
--- a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c
+++ b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c
@@ -129,6 +129,69 @@ static int vamos_cam_sensor_bitbang_chipid(struct cam_sensor_ctrl_t *s_ctrl)
 	scl_gpio = tlmm_base + (s_ctrl->cci_i2c_master ? 20 : 18);
 	sid7 = s_ctrl->sensordata->slave_info.sensor_slave_addr >> 1;
 	reg_addr = s_ctrl->sensordata->slave_info.sensor_id_reg_addr;
+
+	{
+		int i;
+		int mclk_gpio = -EINVAL;
+		const char *mclk_source = "none";
+
+		if (gpio_num_info->valid[SENSOR_MCLK]) {
+			mclk_gpio = gpio_num_info->gpio_num[SENSOR_MCLK];
+			mclk_source = "gpio-num-info";
+		} else if (s_ctrl->soc_info.gpio_data &&
+			s_ctrl->soc_info.gpio_data->cam_gpio_req_tbl) {
+			cam_gpio *gpio_tbl =
+				s_ctrl->soc_info.gpio_data->cam_gpio_req_tbl;
+			uint8_t size =
+				s_ctrl->soc_info.gpio_data->cam_gpio_req_tbl_size;
+
+			for (i = 0; i < size; i++) {
+				if (!gpio_tbl[i].label ||
+					strncmp(gpio_tbl[i].label, "CAMIF_MCLK",
+						sizeof("CAMIF_MCLK") - 1))
+					continue;
+				mclk_gpio = gpio_tbl[i].gpio;
+				mclk_source = "req-tbl";
+				break;
+			}
+		}
+
+		if (gpio_is_valid(mclk_gpio)) {
+			int val;
+			int prev;
+			int ones = 0;
+			int zeros = 0;
+			int transitions = 0;
+
+			prev = vamos_cam_i2c_sample(mclk_gpio);
+			if (prev)
+				ones++;
+			else
+				zeros++;
+
+			for (i = 1; i < 256; i++) {
+				udelay(1);
+				val = vamos_cam_i2c_sample(mclk_gpio);
+				if (val)
+					ones++;
+				else
+					zeros++;
+				if (val != prev)
+					transitions++;
+				prev = val;
+			}
+			pr_emerg("vamos-cam-bitbang: slot %d mclk-sample valid=1 source=%s num_valid=%u gpio=%d ones=%d zeros=%d transitions=%d final=%d\n",
+				s_ctrl->soc_info.index, mclk_source,
+				gpio_num_info->valid[SENSOR_MCLK], mclk_gpio,
+				ones, zeros, transitions, prev);
+		} else {
+			pr_emerg("vamos-cam-bitbang: slot %d mclk-sample valid=0 source=%s num_valid=%u gpio=%d req_tbl=%pK\n",
+				s_ctrl->soc_info.index, mclk_source,
+				gpio_num_info->valid[SENSOR_MCLK], mclk_gpio,
+				s_ctrl->soc_info.gpio_data ?
+					s_ctrl->soc_info.gpio_data->cam_gpio_req_tbl : NULL);
+		}
+	}
 
 	sda_before = vamos_cam_i2c_sample(sda_gpio);
 	scl_before = vamos_cam_i2c_sample(scl_gpio);
