+		bus_client->common_data.name, rc);
 	if (rc) {
 		CAM_ERR(CAM_CPAS,
 			"Update bw failed, ab[%llu] ib[%llu]",
@@ -832,6 +836,9 @@ static int cam_cpas_util_apply_client_axi_vote(
 	uint64_t applied_ab = 0, applied_ib = 0;
 
 	mutex_lock(&cpas_core->tree_lock);
+	pr_err("vamos-bw: cpas apply_client_axi_vote client=%s tree_valid=%d path0 ab=%llu\n",
+		cpas_client->data.identifier, cpas_client->tree_node_valid,
+		axi_vote->axi_path[0].mnoc_ab_bw);
 	if (!cpas_client->tree_node_valid) {
 		/*
 		 * This is by assuming apply_client_axi_vote is called
@@ -1003,10 +1010,16 @@ static int cam_cpas_util_apply_client_axi_vote(
 		else
 			mnoc_ib_bw = 0;
 
+		pr_err("vamos-bw: cpas port[%s] icc vote ab=%llu ib=%llu additional=%lld\n",
+			mnoc_axi_port->axi_port_name, mnoc_ab_bw, mnoc_ib_bw,
+			mnoc_axi_port->additional_bw);
 		rc = cam_cpas_util_vote_bus_client_bw(
 			&mnoc_axi_port->bus_client,
 			mnoc_ab_bw, mnoc_ib_bw, false, &applied_ab,
 			&applied_ib);
+		pr_err("vamos-bw: cpas port[%s] icc vote done rc=%d applied ab=%llu ib=%llu\n",
+			mnoc_axi_port->axi_port_name, rc, applied_ab,
+			applied_ib);
 		if (rc) {
 			CAM_ERR(CAM_CPAS,
 				"Failed in mnoc vote ab[%llu] ib[%llu] rc=%d",
@@ -1016,8 +1029,10 @@ static int cam_cpas_util_apply_client_axi_vote(
 		mnoc_axi_port->applied_ab_bw = applied_ab;
 		mnoc_axi_port->applied_ib_bw = applied_ib;
 	}
+	pr_err("vamos-bw: cpas camnoc_set_vote_axi_clk_rate...\n");
 	rc = cam_cpas_camnoc_set_vote_axi_clk_rate(
 		cpas_hw, camnoc_axi_port_updated);
+	pr_err("vamos-bw: cpas camnoc_set_vote_axi_clk_rate done rc=%d\n", rc);
 	if (rc)
 		CAM_ERR(CAM_CPAS, "Failed in setting axi clk rate rc=%d", rc);
 
