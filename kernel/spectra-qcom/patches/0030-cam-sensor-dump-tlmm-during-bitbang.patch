@@ -18,6 +18,82 @@
 
 
 #define VAMOS_CAM_I2C_DELAY_US 5
+#define VAMOS_CAM_SDM845_TLMM_PHYS 0x03400000
+#define VAMOS_CAM_SDM845_TLMM_EAST 0x00100000
+#define VAMOS_CAM_SDM845_TLMM_NORTH 0x00500000
+#define VAMOS_CAM_SDM845_TLMM_SOUTH 0x00900000
+#define VAMOS_CAM_SDM845_TLMM_REG_SIZE 0x1000
+#define VAMOS_CAM_SDM845_TLMM_MAP_SIZE 0xc00000
+#define VAMOS_CAM_SDM845_TLMM_GLOBAL_BASE 552
+
+static int vamos_cam_sdm845_tlmm_region(unsigned int local_gpio)
+{
+	if (local_gpio > 150)
+		return -EINVAL;
+
+	switch (local_gpio) {
+	case 7:
+	case 31 ... 34:
+	case 49 ... 68:
+	case 79 ... 84:
+	case 97 ... 121:
+	case 127 ... 149:
+		return VAMOS_CAM_SDM845_TLMM_NORTH;
+	case 0 ... 3:
+	case 8 ... 11:
+	case 27 ... 30:
+	case 39:
+	case 41 ... 48:
+	case 69 ... 78:
+	case 85 ... 88:
+	case 122 ... 126:
+		return VAMOS_CAM_SDM845_TLMM_EAST;
+	default:
+		return VAMOS_CAM_SDM845_TLMM_SOUTH;
+	}
+}
+
+static void vamos_cam_bitbang_dump_tlmm(const char *tag, unsigned int gpio)
+{
+	void __iomem *tlmm;
+	int local_gpio;
+	int region;
+	u32 offset;
+	u32 ctl;
+	u32 io;
+
+	if (gpio < VAMOS_CAM_SDM845_TLMM_GLOBAL_BASE)
+		return;
+
+	local_gpio = gpio - VAMOS_CAM_SDM845_TLMM_GLOBAL_BASE;
+	region = vamos_cam_sdm845_tlmm_region(local_gpio);
+	if (region < 0) {
+		pr_emerg("vamos-cam-bitbang: tlmm %s gpio=%u local=%d region invalid\n",
+			tag, gpio, local_gpio);
+		return;
+	}
+
+	tlmm = ioremap(VAMOS_CAM_SDM845_TLMM_PHYS,
+		VAMOS_CAM_SDM845_TLMM_MAP_SIZE);
+	if (!tlmm) {
+		pr_emerg("vamos-cam-bitbang: tlmm %s gpio=%u local=%d ioremap failed\n",
+			tag, gpio, local_gpio);
+		return;
+	}
+
+	offset = region + (local_gpio * VAMOS_CAM_SDM845_TLMM_REG_SIZE);
+	ctl = readl_relaxed(tlmm + offset);
+	io = readl_relaxed(tlmm + offset + 0x4);
+	pr_emerg("vamos-cam-bitbang: tlmm %s gpio=%u local=%d ctl=0x%x mux=%u pull=%u drv=%u oe=%u io=0x%x in=%u out=%u\n",
+		tag, gpio, local_gpio, ctl,
+		(ctl >> 2) & 0xf,
+		ctl & 0x3,
+		(ctl >> 6) & 0x7,
+		(ctl >> 9) & 0x1,
+		io, io & 0x1, (io >> 1) & 0x1);
+
+	iounmap(tlmm);
+}
 
