From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Trey Moen <trey@moen.ai>
Date: Thu, 2 Jul 2026 18:33:40 -0700
Subject: [PATCH] cam: smmu: do not put the secure-heap dmabuf

The mainline import path does not take the extra dmabuf reference the
downstream secure-heap flow assumed; dropping the put avoids a
refcount underflow on teardown.
---
 .../msm/camera/camera_kt/drivers/cam_smmu/cam_smmu_api.c        | 2 --
 1 file changed, 2 deletions(-)

diff --git a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_smmu/cam_smmu_api.c b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_smmu/cam_smmu_api.c
index 869c445..44f8b48 100644
--- a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_smmu/cam_smmu_api.c
+++ b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_smmu/cam_smmu_api.c
@@ -1914,7 +1914,6 @@ err_detach:
 	dma_buf_detach(secheap_buf->buf,
 		secheap_buf->attach);
 err_put:
-	dma_buf_put(secheap_buf->buf);
 err_out:
 	mutex_unlock(&iommu_cb_set.cb_info[idx].lock);
 	return rc;
@@ -1964,7 +1963,6 @@ int cam_smmu_release_sec_heap(int32_t smmu_hdl)
 	dma_buf_unmap_attachment(secheap_buf->attach,
 		secheap_buf->table, DMA_BIDIRECTIONAL);
 	dma_buf_detach(secheap_buf->buf, secheap_buf->attach);
-	dma_buf_put(secheap_buf->buf);
 	iommu_cb_set.cb_info[idx].is_secheap_allocated = false;
 	mutex_unlock(&iommu_cb_set.cb_info[idx].lock);
 
