From 8f15fb92e6ebf448cb4e2f3dd7847f1c2bc1a3b1 Mon Sep 17 00:00:00 2001
From: Trey <trey@comma.ai>
Date: Mon, 15 Jun 2026 11:20:00 +0000
Subject: cam-sensor: dump SDM845 CAM_CC MCLK registers during probe

The TLMM breadcrumbs show whether the MCLK pad is muxed to cam_mclk, but
they do not show whether the CAM_CC source and branch are actually
programmed and enabled. Dump the SDM845 MCLK RCGR and branch registers
around clock enable so sensor NACK bring-up can distinguish a pad mux issue
from a dead MCLK branch/source.
---
 .../cam_sensor_utils/cam_sensor_util.c       | 101 ++++++++++++++++++
 1 file changed, 101 insertions(+)

diff --git a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor_utils/cam_sensor_util.c b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor_utils/cam_sensor_util.c
index 99575a1a1..8d5745d7a 100644
--- a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor_utils/cam_sensor_util.c
+++ b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor_utils/cam_sensor_util.c
@@ -25,6 +25,10 @@
 #define CAM_SENSOR_SDM845_TLMM_REG_SIZE 0x1000
 #define CAM_SENSOR_SDM845_TLMM_MAP_SIZE 0xc00000
 #define CAM_SENSOR_SDM845_TLMM_GLOBAL_BASE 552
+#define CAM_SENSOR_SDM845_CAMCC_PHYS 0x0ad00000
+#define CAM_SENSOR_SDM845_CAMCC_MAP_SIZE 0x10000
+#define CAM_SENSOR_SDM845_MCLK0_CMD_RCGR 0x4004
+#define CAM_SENSOR_SDM845_MCLK0_BRANCH 0x401c
 
 static bool cam_sensor_gpio_label_is_mclk(const cam_gpio *gpio)
 {
@@ -48,6 +52,81 @@ static int cam_sensor_sdm845_local_gpio(unsigned int gpio)
 	return -EINVAL;
 }
 
+static int cam_sensor_sdm845_mclk_index(const cam_gpio *gpio)
+{
+	int local_gpio;
+	const char *label;
+
+	if (!cam_sensor_gpio_label_is_mclk(gpio))
+		return -EINVAL;
+
+	label = gpio->label;
+	if (!strncmp(label, "CAMIF_MCLK0", sizeof("CAMIF_MCLK0") - 1))
+		return 0;
+	if (!strncmp(label, "CAMIF_MCLK1", sizeof("CAMIF_MCLK1") - 1))
+		return 1;
+	if (!strncmp(label, "CAMIF_MCLK2", sizeof("CAMIF_MCLK2") - 1))
+		return 2;
+	if (!strncmp(label, "CAMIF_MCLK3", sizeof("CAMIF_MCLK3") - 1))
+		return 3;
+
+	local_gpio = cam_sensor_sdm845_local_gpio(gpio->gpio);
+	switch (local_gpio) {
+	case 13:
+		return 0;
+	case 14:
+		return 1;
+	case 15:
+		return 2;
+	case 16:
+		return 3;
+	default:
+		return -EINVAL;
+	}
+}
+
+static void cam_sensor_dump_sdm845_camcc_mclk(const char *tag,
+	const cam_gpio *gpio)
+{
+	void __iomem *camcc;
+	u32 cmd_rcgr;
+	u32 branch;
+	u32 cmd;
+	u32 cfg;
+	u32 m;
+	u32 n;
+	u32 d;
+	int index;
+
+	index = cam_sensor_sdm845_mclk_index(gpio);
+	if (index < 0)
+		return;
+
+	cmd_rcgr = CAM_SENSOR_SDM845_MCLK0_CMD_RCGR + (index * 0x20);
+	branch = CAM_SENSOR_SDM845_MCLK0_BRANCH + (index * 0x20);
+	camcc = ioremap(CAM_SENSOR_SDM845_CAMCC_PHYS,
+		CAM_SENSOR_SDM845_CAMCC_MAP_SIZE);
+	if (!camcc) {
+		pr_emerg("vamos-cam-sensor: camcc-mclk %s idx=%d gpio=%u label=%s ioremap failed\n",
+			tag, index, gpio->gpio, gpio->label ?: "<null>");
+		return;
+	}
+
+	cmd = readl_relaxed(camcc + cmd_rcgr);
+	cfg = readl_relaxed(camcc + cmd_rcgr + 0x4);
+	m = readl_relaxed(camcc + cmd_rcgr + 0x8);
+	n = readl_relaxed(camcc + cmd_rcgr + 0xc);
+	d = readl_relaxed(camcc + cmd_rcgr + 0x10);
+	pr_emerg("vamos-cam-sensor: camcc-mclk %s idx=%d gpio=%u label=%s cmd_rcgr=0x%x cmd=0x%x cfg=0x%x src=%u hid=%u m=0x%x n=0x%x d=0x%x branch_reg=0x%x branch=0x%x enable=%u halt=%u\n",
+		tag, index, gpio->gpio, gpio->label ?: "<null>",
+		cmd_rcgr, cmd, cfg, cfg & 0x7, (cfg >> 8) & 0x1f,
+		m, n, d, branch, readl_relaxed(camcc + branch),
+		readl_relaxed(camcc + branch) & 0x1,
+		(readl_relaxed(camcc + branch) >> 31) & 0x1);
+
+	iounmap(camcc);
+}
+
 static int cam_sensor_sdm845_tlmm_region(unsigned int local_gpio)
 {
 	switch (local_gpio) {
@@ -113,6 +188,18 @@ static void cam_sensor_dump_sdm845_tlmm_table(const char *tag,
 			gpio_tbl[i].label);
 }
 
+static void cam_sensor_dump_sdm845_camcc_mclk_table(const char *tag,
+	cam_gpio *gpio_tbl, uint8_t size)
+{
+	int i;
+
+	if (!gpio_tbl)
+		return;
+
+	for (i = 0; i < size; i++)
+		cam_sensor_dump_sdm845_camcc_mclk(tag, &gpio_tbl[i]);
+}
+
 #define VALIDATE_VOLTAGE(min, max, config_val) ((config_val) && \
 	(config_val >= min) && (config_val <= max))
 
@@ -2423,6 +2509,11 @@ int cam_sensor_core_power_up(struct cam_sensor_power_ctrl_t *ctrl,
 					soc_info->gpio_data->cam_gpio_req_tbl : NULL,
 				soc_info->gpio_data ?
 					soc_info->gpio_data->cam_gpio_req_tbl_size : 0);
+			cam_sensor_dump_sdm845_camcc_mclk_table("before-mclk-enable",
+				soc_info->gpio_data ?
+					soc_info->gpio_data->cam_gpio_req_tbl : NULL,
+				soc_info->gpio_data ?
+					soc_info->gpio_data->cam_gpio_req_tbl_size : 0);
 			for (j = 0; j < soc_info->num_clk; j++) {
 				rc = cam_soc_util_clk_enable(soc_info->clk[j],
 					soc_info->clk_name[j],
@@ -2438,6 +2529,11 @@ int cam_sensor_core_power_up(struct cam_sensor_power_ctrl_t *ctrl,
 					soc_info->gpio_data->cam_gpio_req_tbl : NULL,
 				soc_info->gpio_data ?
 					soc_info->gpio_data->cam_gpio_req_tbl_size : 0);
+			cam_sensor_dump_sdm845_camcc_mclk_table("after-mclk-enable",
+				soc_info->gpio_data ?
+					soc_info->gpio_data->cam_gpio_req_tbl : NULL,
+				soc_info->gpio_data ?
+					soc_info->gpio_data->cam_gpio_req_tbl_size : 0);
 
 			if (rc < 0) {
 				CAM_ERR(CAM_SENSOR, "clk enable failed");
-- 
