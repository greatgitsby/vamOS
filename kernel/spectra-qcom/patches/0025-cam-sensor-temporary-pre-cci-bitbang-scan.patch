diff --git a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c
--- a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c
+++ b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c
@@ -190,6 +190,75 @@ static int vamos_cam_sensor_bitbang_chipid(struct cam_sensor_ctrl_t *s_ctrl)
 	sda_after_req = vamos_cam_i2c_sample(sda_gpio);
 	scl_after_req = vamos_cam_i2c_sample(scl_gpio);
 
+	{
+		int scan_master;
+
+		for (scan_master = 0; scan_master <= 1; scan_master++) {
+		int addr;
+		int hits = 0;
+		int expected_ack = -1;
+		int scan_sda = tlmm_base + (scan_master ? 19 : 17);
+		int scan_scl = tlmm_base + (scan_master ? 20 : 18);
+		int scan_idle_sda;
+		int scan_idle_scl;
+		bool already_requested = (scan_sda == sda_gpio) &&
+			(scan_scl == scl_gpio);
+
+		if (!already_requested) {
+			rc = gpio_request(scan_sda, "vamos_cam_diag_scan_sda");
+			if (rc) {
+				pr_emerg("vamos-cam-bitbang: slot %d scan request-sda master=%d gpio=%d rc=%d\n",
+					s_ctrl->soc_info.index, scan_master,
+					scan_sda, rc);
+				continue;
+			}
+			rc = gpio_request(scan_scl, "vamos_cam_diag_scan_scl");
+			if (rc) {
+				pr_emerg("vamos-cam-bitbang: slot %d scan request-scl master=%d gpio=%d rc=%d\n",
+					s_ctrl->soc_info.index, scan_master,
+					scan_scl, rc);
+				gpio_free(scan_sda);
+				continue;
+			}
+		}
+
+		vamos_cam_i2c_release(scan_sda);
+		vamos_cam_i2c_release(scan_scl);
+		scan_idle_sda = vamos_cam_i2c_sample(scan_sda);
+		scan_idle_scl = vamos_cam_i2c_sample(scan_scl);
+
+		pr_emerg("vamos-cam-bitbang: slot %d scan begin master=%d expected_sid7=0x%02x sda=%d scl=%d idle_sda=%d idle_scl=%d\n",
+			s_ctrl->soc_info.index, scan_master, sid7,
+			scan_sda, scan_scl, scan_idle_sda, scan_idle_scl);
+		for (addr = 0x03; addr <= 0x77; addr++) {
+			int nack;
+
+			vamos_cam_i2c_stop(scan_sda, scan_scl);
+			vamos_cam_i2c_start(scan_sda, scan_scl);
+			nack = vamos_cam_i2c_write_byte(scan_sda, scan_scl,
+				(addr << 1) | 0);
+			vamos_cam_i2c_stop(scan_sda, scan_scl);
+			if (addr == sid7)
+				expected_ack = !nack;
+			if (!nack) {
+				hits++;
+				pr_emerg("vamos-cam-bitbang: slot %d scan-hit master=%d sid7=0x%02x expected=%d\n",
+					s_ctrl->soc_info.index,
+					scan_master, addr, addr == sid7);
+			}
+		}
+		pr_emerg("vamos-cam-bitbang: slot %d scan end master=%d hits=%d expected_sid7=0x%02x expected_ack=%d final_sda=%d final_scl=%d\n",
+			s_ctrl->soc_info.index, scan_master, hits,
+			sid7, expected_ack, vamos_cam_i2c_sample(scan_sda),
+			vamos_cam_i2c_sample(scan_scl));
+
+		if (!already_requested) {
+			gpio_free(scan_scl);
+			gpio_free(scan_sda);
+		}
+		}
+	}
+
 	vamos_cam_i2c_start(sda_gpio, scl_gpio);
 	nack_addr_w = vamos_cam_i2c_write_byte(sda_gpio, scl_gpio,
 		(sid7 << 1) | 0);
@@ -232,6 +301,6 @@ static int vamos_cam_sensor_bitbang_chipid(struct cam_sensor_ctrl_t *s_ctrl)
 		b0, b1, chipid);
 
-	if (gpio_num_info->valid[SENSOR_RESET]) {
+	if (gpio_num_info->valid[SENSOR_RESET]) {
 		int reset_gpio = gpio_num_info->gpio_num[SENSOR_RESET];
 		int reset_before = gpio_get_value_cansleep(reset_gpio);
 		int retry_nack_addr_w;
@@ -1779,7 +1848,7 @@ int cam_sensor_power_up(struct cam_sensor_ctrl_t *s_ctrl)
 			s_ctrl->soc_info.index, diag_found);
 	}
 
-	if (false && s_ctrl->io_master_info.master_type == CCI_MASTER)
+	if (false && s_ctrl->io_master_info.master_type == CCI_MASTER)
 		pr_emerg("vamos-cam-sensor: slot %d temporary pre-cci bitbang rc=%d\n",
 			s_ctrl->soc_info.index,
 			vamos_cam_sensor_bitbang_chipid(s_ctrl));
