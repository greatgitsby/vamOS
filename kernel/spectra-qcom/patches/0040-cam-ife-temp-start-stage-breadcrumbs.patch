 	if (rc) {
 		CAM_ERR(CAM_ISP, "Init failed");
 		goto tasklet_stop;
@@ -4805,7 +4810,26 @@ start_only:
 
 	/* Apply initial configuration */
 	CAM_DBG(CAM_ISP, "Config HW");
+	{
+		void __iomem *camcc = ioremap(0x0ad00000, 0xc000);
+		void __iomem *cdmr = ioremap(0x0ac48000, 0x1000);
+		if (camcc) {
+			pr_err("vamos-ife: GDSCR titan=0x%x ife0=0x%x ife1=0x%x\n",
+				readl_relaxed(camcc + 0xb134),
+				readl_relaxed(camcc + 0x9004),
+				readl_relaxed(camcc + 0xa004));
+			iounmap(camcc);
+		}
+		if (cdmr) {
+			pr_err("vamos-ife: about to READ CDM reg @ac48000...\n");
+			pr_err("vamos-ife: CDM hw-version reads 0x%x (CDM alive)\n",
+				readl_relaxed(cdmr));
+			iounmap(cdmr);
+		}
+	}
+	pr_err("vamos-ife: start_hw: config_hw (CDM submit) begin\n");
 	rc = cam_ife_mgr_config_hw(hw_mgr_priv, &start_isp->hw_config);
+	pr_err("vamos-ife: start_hw: config_hw done rc=%d\n", rc);
 	if (rc) {
 		CAM_ERR(CAM_ISP,
 			"Config HW failed, start_only=%d, rc=%d",
@@ -4862,6 +4886,7 @@ start_only:
 		}
 	}
 
+	pr_err("vamos-ife: START IFE BUS RD\n");
 	CAM_DBG(CAM_ISP, "START IFE BUS RD ... in ctx id:%d", ctx->ctx_index);
 	/* Start IFE Bus RD devices */
 	list_for_each_entry(hw_mgr_res, &ctx->res_list_ife_in_rd, list) {
