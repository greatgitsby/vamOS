From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Trey Moen <trey@moen.ai>
Date: Thu, 2 Jul 2026 18:35:06 -0700
Subject: [PATCH] cam: sensor: enable the power domain at the MCLK step

Legacy AGNOS models TITAN_TOP_GDSC as the sensor cam_clk supply and
turns it on with the MCLK power step, not during the VIO/VANA/VDIG
regulator steps. Move cam_soc_util_power_domain_enable_default() to the
MCLK step (and the disable to the matching power-down step) so the
bring-up order matches the working legacy sequence while keeping the
mainline power-domain attachment.
---
 .../cam_sensor_utils/cam_sensor_util.c            | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor_utils/cam_sensor_util.c b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor_utils/cam_sensor_util.c
index 51135ec..d1429fe 100644
--- a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor_utils/cam_sensor_util.c
+++ b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor_utils/cam_sensor_util.c
@@ -2142,6 +2142,12 @@ int cam_sensor_core_power_up(struct cam_sensor_power_ctrl_t *ctrl,
 					soc_info->num_clk);
 				goto power_up_failed;
 			}
+			rc = cam_soc_util_power_domain_enable_default(soc_info);
+			if (rc < 0) {
+				CAM_ERR(CAM_SENSOR,
+					"Power domain enable failed with rc = %d", rc);
+				goto power_up_failed;
+			}
 			for (j = 0; j < num_vreg; j++) {
 				if (!strcmp(soc_info->rgltr_name[j],
 					"cam_clk")) {
@@ -2275,12 +2281,6 @@ int cam_sensor_core_power_up(struct cam_sensor_power_ctrl_t *ctrl,
 					power_setting->seq_val, num_vreg);
 			}
 
-			rc = cam_soc_util_power_domain_enable_default(soc_info);
-			if (rc < 0) {
-				CAM_ERR(CAM_SENSOR,
-					"Power domain enable failed with rc = %d", rc);
-				goto power_up_failed;
-			}
 			rc = msm_cam_sensor_handle_reg_gpio(
 				power_setting->seq_type,
 				gpio_num_info, 1);
@@ -2483,6 +2483,8 @@ int cam_sensor_util_power_down(struct cam_sensor_power_ctrl_t *ctrl,
 					"config clk reg failed rc: %d", ret);
 				continue;
 			}
+			cam_soc_util_power_domain_disable_default(soc_info);
+			ret = 0;
 			break;
 		case SENSOR_RESET:
 		case SENSOR_STANDBY:
@@ -2552,7 +2554,6 @@ int cam_sensor_util_power_down(struct cam_sensor_power_ctrl_t *ctrl,
 				CAM_ERR(CAM_SENSOR,
 					"error in power up/down seq");
 
-			cam_soc_util_power_domain_disable_default(soc_info);
 
 			ret = msm_cam_sensor_handle_reg_gpio(pd->seq_type,
 				gpio_num_info, GPIOF_OUT_INIT_LOW);
