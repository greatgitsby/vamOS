+			pr_emerg("vamos-cam-util: gpio-free dev=%s i=%d gpio=%u label=%s\n",
+				cam_soc_util_safe_dev_name(soc_info), i,
+				gpio_tbl[i].gpio, gpio_tbl[i].label ?: "<null>");
 			gpio_free(gpio_tbl[i].gpio);
