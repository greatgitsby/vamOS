+			pr_emerg("vamos-cam-util: gpio-request dev=%s i=%d gpio=%u label=%s rc=%d\n",
+				cam_soc_util_safe_dev_name(soc_info), i,
+				gpio_tbl[i].gpio, gpio_tbl[i].label ?: "<null>",
+				rc);
 			if (rc) {
 				/*
 				 * After GPIO request fails, contine to
@@ -1254,10 +1395,29 @@ static int cam_soc_util_request_gpio_table(
 			}
 		}
 	} else {
-		for (i = 0; i < size; i++)
+		for (i = 0; i < size; i++) {
+			if (cam_soc_util_gpio_label_is_cci_i2c(&gpio_tbl[i])) {
+				pr_emerg("vamos-cam-util: skip-cci-i2c-gpio-free dev=%s i=%d gpio=%u label=%s\n",
+					cam_soc_util_safe_dev_name(soc_info), i,
+					gpio_tbl[i].gpio,
+					gpio_tbl[i].label ?: "<null>");
+				cam_soc_util_dump_sdm845_tlmm_gpio(
