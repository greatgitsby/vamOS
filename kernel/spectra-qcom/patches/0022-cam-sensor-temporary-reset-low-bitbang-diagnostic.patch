diff --git a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c
--- a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c
+++ b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c
@@ -198,6 +198,48 @@ static int vamos_cam_sensor_bitbang_chipid(struct cam_sensor_ctrl_t *s_ctrl)
 		nack_addr_w, nack_reg_hi, nack_reg_lo, nack_addr_r,
 		b0, b1, chipid);
 
+	if (gpio_num_info->valid[SENSOR_RESET]) {
+		int reset_gpio = gpio_num_info->gpio_num[SENSOR_RESET];
+		int reset_before = gpio_get_value_cansleep(reset_gpio);
+		int retry_nack_addr_w;
+		int retry_nack_reg_hi;
+		int retry_nack_reg_lo;
+		int retry_nack_addr_r;
+		uint8_t retry_b0;
+		uint8_t retry_b1;
+		uint16_t retry_chipid;
+
+		pr_emerg("vamos-cam-bitbang: slot %d reset-low retry begin reset_gpio=%d before=%d\n",
+			s_ctrl->soc_info.index, reset_gpio, reset_before);
+		gpio_set_value_cansleep(reset_gpio, 0);
+		usleep_range(34000, 35000);
+
+		vamos_cam_i2c_stop(sda_gpio, scl_gpio);
+		vamos_cam_i2c_start(sda_gpio, scl_gpio);
+		retry_nack_addr_w = vamos_cam_i2c_write_byte(sda_gpio,
+			scl_gpio, (sid7 << 1) | 0);
+		retry_nack_reg_hi = vamos_cam_i2c_write_byte(sda_gpio,
+			scl_gpio, (reg_addr >> 8) & 0xff);
+		retry_nack_reg_lo = vamos_cam_i2c_write_byte(sda_gpio,
+			scl_gpio, reg_addr & 0xff);
+		vamos_cam_i2c_start(sda_gpio, scl_gpio);
+		retry_nack_addr_r = vamos_cam_i2c_write_byte(sda_gpio,
+			scl_gpio, (sid7 << 1) | 1);
+		retry_b0 = vamos_cam_i2c_read_byte(sda_gpio, scl_gpio, false);
+		retry_b1 = vamos_cam_i2c_read_byte(sda_gpio, scl_gpio, true);
+		vamos_cam_i2c_stop(sda_gpio, scl_gpio);
+
+		retry_chipid = ((uint16_t)retry_b0 << 8) | retry_b1;
+		pr_emerg("vamos-cam-bitbang: slot %d reset-low result reset_now=%d nack_addr_w=%d nack_reg_hi=%d nack_reg_lo=%d nack_addr_r=%d b0=0x%02x b1=0x%02x chip=0x%04x\n",
+			s_ctrl->soc_info.index,
+			gpio_get_value_cansleep(reset_gpio),
+			retry_nack_addr_w, retry_nack_reg_hi,
+			retry_nack_reg_lo, retry_nack_addr_r,
+			retry_b0, retry_b1, retry_chipid);
+		gpio_set_value_cansleep(reset_gpio, reset_before);
+		usleep_range(34000, 35000);
+	}
+
 	gpio_free(scl_gpio);
 	gpio_free(sda_gpio);
 	return 0;
