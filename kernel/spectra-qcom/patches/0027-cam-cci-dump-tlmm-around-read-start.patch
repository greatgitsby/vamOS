 #include <linux/module.h>
 #include "cam_cci_core.h"
 #include "cam_cci_dev.h"
 #include "cam_req_mgr_workq.h"
 #include "cam_common_util.h"
 
+#define CAM_CCI_SDM845_TLMM_PHYS 0x03400000
+#define CAM_CCI_SDM845_TLMM_EAST 0x00100000
+#define CAM_CCI_SDM845_TLMM_NORTH 0x00500000
+#define CAM_CCI_SDM845_TLMM_SOUTH 0x00900000
+#define CAM_CCI_SDM845_TLMM_REG_SIZE 0x1000
+#define CAM_CCI_SDM845_TLMM_MAP_SIZE 0xc00000
+
+static int cam_cci_sdm845_tlmm_region(unsigned int local_gpio)
+{
+	switch (local_gpio) {
+	case 7:
+	case 31 ... 34:
+	case 49 ... 68:
+	case 79 ... 84:
+	case 97 ... 121:
+	case 127 ... 149:
+		return CAM_CCI_SDM845_TLMM_NORTH;
+	case 0 ... 3:
+	case 8 ... 11:
+	case 27 ... 30:
+	case 39:
+	case 41 ... 48:
+	case 69 ... 78:
+	case 85 ... 88:
+	case 122 ... 126:
+		return CAM_CCI_SDM845_TLMM_EAST;
+	default:
+		return CAM_CCI_SDM845_TLMM_SOUTH;
+	}
+}
+
+static void cam_cci_dump_sdm845_tlmm_one(void __iomem *tlmm,
+	const char *tag, enum cci_i2c_master_t master, unsigned int local_gpio)
+{
+	u32 ctl;
+	u32 io;
+	u32 offset;
+
+	offset = cam_cci_sdm845_tlmm_region(local_gpio) +
+		(local_gpio * CAM_CCI_SDM845_TLMM_REG_SIZE);
+	ctl = readl_relaxed(tlmm + offset);
+	io = readl_relaxed(tlmm + offset + 0x4);
+	pr_emerg("vamos-cam-cci: tlmm %s master=%d gpio=%u ctl=0x%x mux=%u pull=%u drv=%u oe=%u io=0x%x in=%u out=%u\n",
+		tag, master, local_gpio, ctl, (ctl >> 2) & 0xf, ctl & 0x3,
+		(ctl >> 6) & 0x7, (ctl >> 9) & 0x1, io, io & 0x1,
+		(io >> 1) & 0x1);
+}
+
+static void cam_cci_dump_sdm845_tlmm_bus(const char *tag,
+	enum cci_i2c_master_t master)
+{
+	void __iomem *tlmm;
+	unsigned int sda_gpio;
+	unsigned int scl_gpio;
+
+	if (master >= MASTER_MAX)
+		return;
+
+	sda_gpio = master == MASTER_1 ? 19 : 17;
+	scl_gpio = master == MASTER_1 ? 20 : 18;
+	tlmm = ioremap(CAM_CCI_SDM845_TLMM_PHYS,
+		CAM_CCI_SDM845_TLMM_MAP_SIZE);
+	if (!tlmm) {
+		pr_emerg("vamos-cam-cci: tlmm %s master=%d ioremap failed\n",
+			tag, master);
+		return;
+	}
+
+	cam_cci_dump_sdm845_tlmm_one(tlmm, tag, master, sda_gpio);
+	cam_cci_dump_sdm845_tlmm_one(tlmm, tag, master, scl_gpio);
+	iounmap(tlmm);
+}
+
