diff --git a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c
--- a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c
+++ b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_sensor_module/cam_sensor/cam_sensor_core.c
@@ -7,6 +7,7 @@
 #include <linux/module.h>
 #include <linux/gpio.h>
 #include <linux/delay.h>
+#include <linux/io.h>
 #include <cam_sensor_cmn_header.h>
 #include "cam_sensor_core.h"
 #include "cam_res_mgr_api.h"
@@ -21,6 +22,46 @@
 
 #define VAMOS_CAM_I2C_DELAY_US 5
 
+#define VAMOS_CAM_SDM845_CAMCC_PHYS 0x0ad00000
+#define VAMOS_CAM_SDM845_CAMCC_MAP_SIZE 0x10000
+#define VAMOS_CAM_SDM845_MCLK0_CMD_RCGR 0x4004
+#define VAMOS_CAM_SDM845_MCLK0_BRANCH 0x401c
+
+static void vamos_cam_sensor_dump_all_mclk_regs(const char *tag,
+	struct cam_sensor_ctrl_t *s_ctrl)
+{
+	void __iomem *camcc;
+	int i;
+
+	camcc = ioremap(VAMOS_CAM_SDM845_CAMCC_PHYS,
+		VAMOS_CAM_SDM845_CAMCC_MAP_SIZE);
+	if (!camcc) {
+		pr_emerg("vamos-cam-sensor: camcc-mclk %s slot=%d ioremap failed\n",
+			tag, s_ctrl ? s_ctrl->soc_info.index : -1);
+		return;
+	}
+
+	for (i = 0; i < 4; i++) {
+		u32 cmd_rcgr = VAMOS_CAM_SDM845_MCLK0_CMD_RCGR + (i * 0x20);
+		u32 branch_reg = VAMOS_CAM_SDM845_MCLK0_BRANCH + (i * 0x20);
+		u32 cmd = readl_relaxed(camcc + cmd_rcgr);
+		u32 cfg = readl_relaxed(camcc + cmd_rcgr + 0x4);
+		u32 m = readl_relaxed(camcc + cmd_rcgr + 0x8);
+		u32 n = readl_relaxed(camcc + cmd_rcgr + 0xc);
+		u32 d = readl_relaxed(camcc + cmd_rcgr + 0x10);
+		u32 branch = readl_relaxed(camcc + branch_reg);
+
+		pr_emerg("vamos-cam-sensor: camcc-mclk %s slot=%d idx=%d cmd_rcgr=0x%x cmd=0x%x cfg=0x%x src=%u hid=%u m=0x%x n=0x%x d=0x%x branch_reg=0x%x branch=0x%x enable=%u halt=%u\n",
+			tag,
+			s_ctrl ? s_ctrl->soc_info.index : -1,
+			i, cmd_rcgr, cmd, cfg, cfg & 0x7,
+			(cfg >> 8) & 0x1f, m, n, d, branch_reg,
+			branch, branch & 0x1, (branch >> 31) & 0x1);
+	}
+
+	iounmap(camcc);
+}
+
 static void vamos_cam_i2c_delay(void)
 {
 	udelay(VAMOS_CAM_I2C_DELAY_US);
@@ -1392,7 +1433,11 @@ int32_t cam_sensor_driver_cmd(struct cam_sensor_ctrl_t *s_ctrl,
 		pr_emerg("vamos-cam-sensor: slot %d powered probe inspection window begin\n",
 			s_ctrl->soc_info.index);
 		pr_emerg("vamos-cam-sensor: temporary powered probe hold 3000ms begin\n");
+		vamos_cam_sensor_dump_all_mclk_regs("pre-match-before-hold",
+			s_ctrl);
 		msleep(3000);
+		vamos_cam_sensor_dump_all_mclk_regs("pre-match-after-hold",
+			s_ctrl);
 		pr_emerg("vamos-cam-sensor: slot %d match_id begin slave=0x%x reg=0x%x expected=0x%x\n",
 			s_ctrl->soc_info.index,
 			s_ctrl->sensordata->slave_info.sensor_slave_addr,
@@ -2039,6 +2084,8 @@ int cam_sensor_power_up(struct cam_sensor_ctrl_t *s_ctrl)
 		CAM_ERR(CAM_SENSOR, "cci_init failed: rc: %d", rc);
 		goto cci_failure;
 	}
+	vamos_cam_sensor_dump_all_mclk_regs("post-camera-io-init",
+		s_ctrl);
 
 	return rc;
 cci_failure:
