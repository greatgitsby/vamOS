+#define CAM_SENSOR_SDM845_TLMM_PHYS 0x03400000
+#define CAM_SENSOR_SDM845_TLMM_EAST 0x00100000
+#define CAM_SENSOR_SDM845_TLMM_NORTH 0x00500000
+#define CAM_SENSOR_SDM845_TLMM_SOUTH 0x00900000
+#define CAM_SENSOR_SDM845_TLMM_REG_SIZE 0x1000
+#define CAM_SENSOR_SDM845_TLMM_MAP_SIZE 0xc00000
+#define CAM_SENSOR_SDM845_TLMM_GLOBAL_BASE 552
+
+static bool cam_sensor_gpio_label_is_mclk(const cam_gpio *gpio)
+{
+	return gpio && gpio->label &&
+		!strncmp(gpio->label, "CAMIF_MCLK", sizeof("CAMIF_MCLK") - 1);
+}
+
+static int cam_sensor_sdm845_local_gpio(unsigned int gpio)
+{
+	if (gpio >= CAM_SENSOR_SDM845_TLMM_GLOBAL_BASE &&
+		gpio < CAM_SENSOR_SDM845_TLMM_GLOBAL_BASE + 151)
+		return gpio - CAM_SENSOR_SDM845_TLMM_GLOBAL_BASE;
+
+	if (gpio < 151)
+		return gpio;
+
+	return -EINVAL;
+}
+
+static int cam_sensor_sdm845_tlmm_region(unsigned int local_gpio)
+{
+	switch (local_gpio) {
+	case 7:
+	case 31 ... 34:
+	case 49 ... 68:
+	case 79 ... 84:
+	case 97 ... 121:
+	case 127 ... 149:
+		return CAM_SENSOR_SDM845_TLMM_NORTH;
+	case 0 ... 3:
+	case 8 ... 11:
+	case 27 ... 30:
+	case 39:
+	case 41 ... 48:
+	case 69 ... 78:
+	case 85 ... 88:
+	case 122 ... 126:
+		return CAM_SENSOR_SDM845_TLMM_EAST;
+	default:
+		return CAM_SENSOR_SDM845_TLMM_SOUTH;
+	}
+}
+
+static void cam_sensor_dump_sdm845_tlmm_gpio(const char *tag,
+	unsigned int gpio, const char *label)
+{
+	void __iomem *tlmm;
+	u32 ctl;
+	u32 io;
+	u32 offset;
+	int local_gpio;
+
+	local_gpio = cam_sensor_sdm845_local_gpio(gpio);
+	if (local_gpio < 0) {
+		pr_emerg("vamos-cam-sensor: tlmm %s gpio=%u label=%s local_gpio=%d invalid\n",
+			tag, gpio, label ?: "<null>", local_gpio);
+		return;
+	}
+
+	offset = cam_sensor_sdm845_tlmm_region(local_gpio) +
+		(local_gpio * CAM_SENSOR_SDM845_TLMM_REG_SIZE);
+	tlmm = ioremap(CAM_SENSOR_SDM845_TLMM_PHYS,
+		CAM_SENSOR_SDM845_TLMM_MAP_SIZE);
+	if (!tlmm) {
+		pr_emerg("vamos-cam-sensor: tlmm %s gpio=%u local=%d label=%s ioremap failed\n",
+			tag, gpio, local_gpio, label ?: "<null>");
+		return;
+	}
+
+	ctl = readl_relaxed(tlmm + offset);
+	io = readl_relaxed(tlmm + offset + 0x4);
+	pr_emerg("vamos-cam-sensor: tlmm %s gpio=%u local=%d label=%s ctl=0x%x mux=%u pull=%u drv=%u oe=%u io=0x%x in=%u out=%u\n",
+		tag, gpio, local_gpio, label ?: "<null>", ctl,
+		(ctl >> 2) & 0xf, ctl & 0x3, (ctl >> 6) & 0x7,
+		(ctl >> 9) & 0x1, io, io & 0x1, (io >> 1) & 0x1);
+	iounmap(tlmm);
+}
+
+static void cam_sensor_dump_sdm845_tlmm_table(const char *tag,
+	cam_gpio *gpio_tbl, uint8_t size)
+{
+	int i;
+
+	if (!gpio_tbl)
+		return;
+
+	for (i = 0; i < size; i++)
+		cam_sensor_dump_sdm845_tlmm_gpio(tag, gpio_tbl[i].gpio,
+			gpio_tbl[i].label);
+}
