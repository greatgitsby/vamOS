From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:01 2001
From: vamos <vamos@comma.ai>
Date: Wed, 1 Jul 2026 22:00:00 -0700
Subject: cam-cdm: TEMP wedge-hunt breadcrumbs around first register access

pr_err breadcrumbs around cam_hw_cdm_init's platform-resource enable and
the first CDM register write (pause_core in reset_hw) to pinpoint the
SoC bus wedge on the serial console. REMOVE once root-caused.
---

diff --git a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_cdm/cam_cdm_hw_core.c b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_cdm/cam_cdm_hw_core.c
index 9c44f3c..b346b89 100644
--- a/drivers/media/platform/msm/camera/camera_kt/drivers/cam_cdm/cam_cdm_hw_core.c
+++ b/drivers/media/platform/msm/camera/camera_kt/drivers/cam_cdm/cam_cdm_hw_core.c
@@ -1651,7 +1651,10 @@ int cam_hw_cdm_reset_hw(struct cam_hw_info *cdm_hw, uint32_t handle)
 	reinit_completion(&cdm_core->reset_complete);
 
 	/* First pause CDM, If it fails still proceed to reset CDM HW */
+	pr_err("vamos-cdm: reset_hw: first reg write (pause_core) base=%pK\n",
+		soc_info->reg_map[0].mem_base);
 	cam_hw_cdm_pause_core(cdm_hw, true);
+	pr_err("vamos-cdm: pause_core survived\n");
 	usleep_range(1000, 1010);
 
 	for (i = 0; i < cdm_core->offsets->reg_data->num_bl_fifo; i++) {
@@ -1976,6 +1979,7 @@ int cam_hw_cdm_init(void *hw_priv,
 	soc_info = &cdm_hw->soc_info;
 	cdm_core = (struct cam_cdm *)cdm_hw->core_info;
 
+	pr_err("vamos-cdm: init enter %s%d\n", soc_info->label_name, soc_info->index);
 	rc = cam_soc_util_enable_platform_resource(soc_info, true,
 		CAM_SVS_VOTE, true);
 	if (rc) {
@@ -1983,6 +1987,7 @@ int cam_hw_cdm_init(void *hw_priv,
 			soc_info->label_name, soc_info->index);
 		goto end;
 	}
+	pr_err("vamos-cdm: platform resources enabled rc=%d\n", rc);
 	spin_lock_irqsave(&cdm_hw->hw_lock, flags);
 	cdm_hw->hw_state = CAM_HW_STATE_POWER_UP;
 	spin_unlock_irqrestore(&cdm_hw->hw_lock, flags);
